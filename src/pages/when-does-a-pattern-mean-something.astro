---
import ParadoxLayout from '../layouts/ParadoxLayout.astro';
import { withBase } from '../data/paradoxes.js';

const base = import.meta.env.BASE_URL;
---

<ParadoxLayout slug="when-does-a-pattern-mean-something">
    <p class="text-slate-600 mb-4">
        <strong>Parts 1&ndash;3 showed that chance alone produces clumps, gaps, and
        streaks.</strong> So when does a cluster actually mean something changed? In
        the next five rounds, two different processes both average the same 20%
        event rate&mdash;your job is to decide what each sequence's pattern actually
        tells you.
    </p>

    <h3 class="text-lg font-bold text-slate-800 mb-3">Part 4: When Does a Pattern Mean Something?</h3>

    <!-- ---------------- Model summary (shown once, before Round 1) ---------------- -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5">
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
            <p class="text-xs font-bold uppercase tracking-wide text-teal-700 mb-1">Constant chance</p>
            <p class="text-sm text-slate-700">Every slot has the same event chance. What happened previously makes no difference.</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
            <p class="text-xs font-bold uppercase tracking-wide text-amber-700 mb-1">Event-dependent</p>
            <p class="text-sm text-slate-700">After an event, another event becomes more likely for a while.</p>
        </div>
    </div>
    <p class="text-center text-sm font-semibold text-slate-600 mb-5">Both average about 20% events overall.</p>

    <!-- ======================================================================
         One persistent challenge region, reused across all 5 rounds. Round change:
         fade out -> replace sequence + labels -> fade in (spec section 38). Previous
         rounds never accumulate; only the current round is ever on screen.
         ====================================================================== -->

    <div id="pc-challenge">
    <div class="flex items-center justify-between mb-2">
        <p id="pc-round-label" class="font-semibold text-slate-700">Round 1 of 5</p>
        <p id="pc-score" class="text-xs text-slate-500" hidden>Evidence calls: <span id="pc-score-value">0</span> / 5</p>
    </div>

    <!-- 60-slot timeline. Deliberately a single wrapped strip (not a square grid like
         Part 1) so it reads as an ordered sequence, per spec section 13. 10 columns x 6
         rows on mobile keeps each cell touch-legible; symbol meaning never depends on
         color alone (filled/empty circle plus an sr-only text summary). -->
    <div id="pc-sequence" class="grid grid-cols-10 gap-1 sm:gap-1.5 mx-auto max-w-sm sm:max-w-xl pc-fade" role="img" aria-label="Sequence of 60 opportunities"></div>
    <p id="pc-sequence-summary" class="sr-only" aria-live="off"></p>

    <!-- ---------------- Answer controls ---------------- -->
    <div class="mt-4 max-w-lg mx-auto">
        <p class="text-center font-semibold text-slate-700 mb-2">What does this sequence tell you?</p>
        <div role="group" aria-label="Your evidence judgment" class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            <button type="button" class="pc-answer-btn" data-answer="constant">Favors constant chance</button>
            <button type="button" class="pc-answer-btn" data-answer="unclear">Not enough to tell</button>
            <button type="button" class="pc-answer-btn" data-answer="dependence">Favors event-dependence</button>
        </div>
    </div>

    <!-- ---------------- Reveal (hidden until the visitor answers) ---------------- -->
    <div id="pc-reveal" class="mt-4 pc-reveal" hidden>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
            <p class="rounded-lg bg-slate-50 border border-slate-200 px-3 py-2">
                <span class="font-semibold text-slate-500">Generated by:</span>
                <span id="pc-generator" class="font-bold text-slate-800"></span>
            </p>
            <p class="rounded-lg bg-slate-50 border border-slate-200 px-3 py-2">
                <span class="font-semibold text-slate-500">Evidence:</span>
                <span id="pc-evidence-category" class="font-bold text-slate-800"></span>
            </p>
        </div>
        <p id="pc-evidence-ratio" class="text-center text-sm text-slate-700 mt-2 font-semibold"></p>
    </div>

    <!-- One persistent feedback box, reused across every round (spec section 37). -->
    <div id="pc-box" class="pc-box">
        <div class="pc-msg" aria-live="polite"></div>
    </div>

    <div class="mt-3 flex items-center justify-between gap-3">
        <button id="pc-show-math" type="button" class="text-sm font-semibold text-purple-600 underline hover:text-purple-800 disabled:opacity-40 disabled:cursor-not-allowed" disabled>
            Show me the math
        </button>
        <button id="pc-next-round" type="button" class="min-h-[44px] px-5 rounded-lg font-semibold shadow-sm transition-colors bg-teal-600 text-white hover:bg-teal-700 disabled:opacity-40 disabled:cursor-not-allowed" disabled>
            Next round
        </button>
    </div>
    </div> <!-- /#pc-challenge -->

    <!-- ---------------- "Show me the math" modal (spec sections 30-35) ---------------- -->
    <dialog id="pc-math-dialog" class="pc-dialog" aria-labelledby="pc-dialog-title">
        <div class="pc-dialog-inner">
            <div class="flex items-start justify-between gap-3 mb-3">
                <h4 id="pc-dialog-title" class="text-lg font-bold text-slate-800">The math behind this round</h4>
                <button id="pc-dialog-close" type="button" class="pc-dialog-close" aria-label="Close">&times;</button>
            </div>

            <section class="mb-4">
                <h5 class="font-semibold text-slate-700 mb-1">The two models</h5>
                <p class="text-sm text-slate-600"><strong>Constant chance:</strong> P(event) = 20% every time, regardless of what happened previously.</p>
                <p class="text-sm text-slate-600"><strong>Event-dependent:</strong> P(event | previous event) = 50%; P(event | previous no-event) = 12.5%.</p>
                <p class="text-sm text-slate-500 mt-1">Both models average 20% events in the long run&mdash;that's deliberate, so the sequence's overall event count can't give away which model produced it.</p>
            </section>

            <section class="mb-4">
                <h5 class="font-semibold text-slate-700 mb-1">Whole-sequence evidence</h5>
                <p id="pc-modal-ratio-line" class="text-sm text-slate-600"></p>
                <p class="text-xs text-slate-500 mt-1">This ratio is a Bayes factor between exactly these two fully-specified models. It is not a probability that either model is "true"&mdash;that would also depend on how likely each model seemed before seeing any data.</p>
            </section>

            <section class="mb-4">
                <h5 class="font-semibold text-slate-700 mb-1">Local cluster</h5>
                <div id="pc-modal-window" class="grid grid-cols-6 gap-1 max-w-[180px] mx-auto mb-2" role="img" aria-label="Densest 6-slot window"></div>
                <p id="pc-modal-scan-line" class="text-sm text-slate-600 text-center"></p>
            </section>

            <section>
                <h5 class="font-semibold text-slate-700 mb-1">Why these can differ</h5>
                <p class="text-sm text-slate-600">These calculations ask different questions.</p>
                <p class="text-sm text-slate-600"><strong>Scan statistic:</strong> How unusual is the strongest local cluster under constant chance?</p>
                <p class="text-sm text-slate-600"><strong>Evidence ratio:</strong> Which of our two complete models predicts the entire sequence better?</p>
                <p class="text-sm text-slate-500 mt-1">A sequence can contain one remarkable local patch without the event-dependent model strongly outperforming constant chance overall&mdash;that's exactly what happens in Round 2.</p>
            </section>

            <div class="mt-4 text-right">
                <button id="pc-dialog-close-bottom" type="button" class="min-h-[44px] px-5 rounded-lg font-semibold shadow-sm transition-colors bg-slate-200 text-slate-700 hover:bg-slate-300">
                    Close
                </button>
            </div>
        </div>
    </dialog>

    <!-- ---------------- Five-round synthesis (hidden until Round 5 is answered) ---------------- -->
    <div id="pc-synthesis" hidden class="mt-6 pc-fade-in">
        <h4 class="font-bold text-slate-800 mb-3">What the five rounds showed</h4>
        <ul class="space-y-2 text-sm text-slate-700">
            <li class="rounded-lg bg-slate-50 border border-slate-100 px-3 py-2"><strong>Chance can look ordinary.</strong> Round 1's small clusters were unremarkable, and the evidence agreed.</li>
            <li class="rounded-lg bg-slate-50 border border-slate-100 px-3 py-2"><strong>Chance can produce a spectacular cluster.</strong> Round 2's six-in-a-row patch was striking, but the whole sequence still didn't clearly favor dependence.</li>
            <li class="rounded-lg bg-slate-50 border border-slate-100 px-3 py-2"><strong>A real change can leave ambiguous data.</strong> Round 3's process really was dependent, yet the sample barely showed it.</li>
            <li class="rounded-lg bg-slate-50 border border-slate-100 px-3 py-2"><strong>A real change can produce strong evidence.</strong> Round 4's dependence was both visible and statistically clear.</li>
            <li class="rounded-lg bg-slate-50 border border-slate-100 px-3 py-2"><strong>Chance can occasionally produce misleading evidence.</strong> Round 5 really was constant chance, even though the numbers leaned the other way.</li>
        </ul>
        <p class="text-center font-bold text-slate-800 mt-4 text-lg">Patterns are evidence&mdash;not verdicts.</p>
    </div>

    <!-- ---------------- Four-part series synthesis ---------------- -->
    <div id="pc-series-synthesis" hidden class="mt-6 pc-fade-in">
        <h4 class="font-bold text-slate-800 mb-3">Putting the four parts together</h4>
        <div class="space-y-2 text-sm text-slate-700">
            <p class="rounded-lg bg-slate-50 border border-slate-100 px-3 py-2"><strong>1. Randomness clumps.</strong> Part 1 showed that genuinely random arrangements naturally contain uneven patches.</p>
            <p class="rounded-lg bg-slate-50 border border-slate-100 px-3 py-2"><strong>2. We imagine randomness as too even.</strong> Part 2 showed that people commonly overalternate when trying to imitate chance.</p>
            <p class="rounded-lg bg-slate-50 border border-slate-100 px-3 py-2"><strong>3. Real randomness makes streaks.</strong> Part 3 showed that independent fair sequences routinely produce repeated outcomes.</p>
            <p class="rounded-lg bg-slate-50 border border-slate-100 px-3 py-2"><strong>4. A cluster must be compared with competing models.</strong> Part 4 showed that the same visible pattern can provide strong, weak, or even misleading evidence depending on the full data and models.</p>
        </div>
    </div>

    <!-- ---------------- Final miracles/coincidences closing (series conclusion) ---------------- -->
    <div id="pc-closing" hidden class="mt-6 p-4 bg-slate-50 border border-slate-100 rounded-xl text-slate-700 pc-fade-in">
        <h4 class="font-bold text-slate-800 mb-2">What does this have to do with miracles and coincidences?</h4>
        <p class="text-sm mb-2">
            When several unusual events happen close together, the cluster itself can feel
            like evidence that they are connected. Sometimes a cluster really is evidence
            that the underlying process changed. But chance also produces clusters&mdash;sometimes
            very striking ones.
        </p>
        <p class="text-sm mb-2">The useful question is not simply:</p>
        <p class="text-sm italic text-center mb-2">&ldquo;Does this look remarkable?&rdquo;</p>
        <p class="text-sm mb-2">It is:</p>
        <p class="text-sm italic text-center mb-2">&ldquo;How often would a pattern at least this remarkable occur under an appropriate chance model, and does another explanation predict the evidence substantially better?&rdquo;</p>
        <p class="text-sm font-semibold">A cluster may justify looking for a connection. Clustering alone does not establish one.</p>
    </div>

    <div class="mt-6">
        <h4 class="font-semibold text-slate-700 mb-2">Important caveats</h4>
        <div class="text-sm text-slate-600 space-y-2">
            <p>
                The five sequences in this exhibit were generated from the two stated models
                and selected to illustrate five distinct evidence outcomes; they are not five
                unfiltered consecutive random draws. The underlying calculations (the evidence
                ratio and the conditional scan probability) are exact for the model definitions
                given here, not simulations.
            </p>
            <p>
                Neither model is presented as more "random" than the other&mdash;both are
                genuinely stochastic processes. The distinction is independence versus
                dependence between successive opportunities, not randomness versus its
                absence. This exhibit also does not evaluate any specific real-world claim of
                a changed process (a streak in sports, markets, or elsewhere); it demonstrates
                the general reasoning, not a verdict on any particular case.
            </p>
        </div>
    </div>

    <div class="mt-6">
        <h4 class="font-semibold text-slate-700 mb-2">Research behind this</h4>
        <div class="text-sm text-slate-600 space-y-2">
            <p>
                <strong>The math</strong> is exact: both the evidence ratio and the conditional
                scan probability are calculated directly from the model definitions (the
                second by dynamic programming over all ways of placing the same number of
                events), not by simulation. <strong>The framing</strong> draws on the Bayesian
                view that a coincidence is an observation that can support an alternative
                explanation without automatically being enough to accept it. <strong>The scan
                statistic</strong> is a standard tool for asking how unusual the densest local
                concentration of events is under a null model, most often used in disease-
                outbreak surveillance; it's used here only as a teaching device, not a
                real surveillance method.
            </p>
            <ul class="list-disc pl-5 space-y-1">
                <li>
                    Griffiths, T. L., &amp; Tenenbaum, J. B. (2007). From mere coincidences to meaningful discoveries.
                    <em>Cognition, 103</em>(2), 180&ndash;226.
                    <a href="https://doi.org/10.1016/j.cognition.2006.03.004" target="_blank" rel="noopener noreferrer" class="text-purple-600 underline hover:text-purple-800">doi:10.1016/j.cognition.2006.03.004</a>
                </li>
                <li>
                    Johansen, M. K., &amp; Osman, M. (2015). Coincidences: A fundamental consequence of rational cognition.
                    <em>New Ideas in Psychology, 39</em>, 34&ndash;44.
                    <a href="https://doi.org/10.1016/j.newideapsych.2015.07.001" target="_blank" rel="noopener noreferrer" class="text-purple-600 underline hover:text-purple-800">doi:10.1016/j.newideapsych.2015.07.001</a>
                </li>
                <li>
                    Johansen, M. K., &amp; Osman, M. (2020). Coincidence judgment in causal reasoning: How coincidental is this?
                    <em>Cognitive Psychology, 120</em>, 101290.
                    <a href="https://doi.org/10.1016/j.cogpsych.2020.101290" target="_blank" rel="noopener noreferrer" class="text-purple-600 underline hover:text-purple-800">doi:10.1016/j.cogpsych.2020.101290</a>
                </li>
                <li>
                    van der Wal, R. C., Sutton, R. M., Lange, J., &amp; Braga, J. P. N. (2018). Suspicious binds: Conspiracy thinking and tenuous perceptions of causal connections between co-occurring and spuriously correlated events.
                    <em>European Journal of Social Psychology, 48</em>(7), 970&ndash;989.
                    <a href="https://doi.org/10.1002/ejsp.2507" target="_blank" rel="noopener noreferrer" class="text-purple-600 underline hover:text-purple-800">doi:10.1002/ejsp.2507</a>
                </li>
                <li>
                    Wallenstein, S., Naus, J., &amp; Glaz, J. (1993). Power of the scan statistic for detection of clustering.
                    <em>Statistics in Medicine, 12</em>(19&ndash;20), 1829&ndash;1843.
                    <a href="https://doi.org/10.1002/sim.4780121910" target="_blank" rel="noopener noreferrer" class="text-purple-600 underline hover:text-purple-800">doi:10.1002/sim.4780121910</a>
                </li>
                <li>
                    Naus, J., &amp; Wallenstein, S. (2006). Temporal surveillance using scan statistics.
                    <em>Statistics in Medicine, 25</em>(2), 311&ndash;324.
                    <a href="https://doi.org/10.1002/sim.2209" target="_blank" rel="noopener noreferrer" class="text-purple-600 underline hover:text-purple-800">doi:10.1002/sim.2209</a>
                </li>
                <li>
                    Robertson, C., Nelson, T. A., MacNab, Y. C., &amp; Lawson, A. B. (2010). Review of methods for space&ndash;time disease surveillance.
                    <em>Spatial and Spatio-temporal Epidemiology, 1</em>(2&ndash;3), 105&ndash;116.
                    <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC7185413/" target="_blank" rel="noopener noreferrer" class="text-purple-600 underline hover:text-purple-800">open access</a>
                </li>
                <li>
                    Kass, R. E., &amp; Raftery, A. E. (1995). Bayes factors.
                    <em>Journal of the American Statistical Association, 90</em>(430), 773&ndash;795.
                    <a href="https://doi.org/10.1080/01621459.1995.10476572" target="_blank" rel="noopener noreferrer" class="text-purple-600 underline hover:text-purple-800">doi:10.1080/01621459.1995.10476572</a>
                </li>
                <li>
                    van Doorn, J., et al., &amp; Wagenmakers, E.-J. (2021). The JASP guidelines for conducting and reporting a Bayesian analysis.
                    <em>Psychonomic Bulletin &amp; Review, 28</em>(3), 813&ndash;826.
                    <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC8219590/" target="_blank" rel="noopener noreferrer" class="text-purple-600 underline hover:text-purple-800">open access</a>
                </li>
                <li>
                    Diaconis, P., &amp; Mosteller, F. (1989). Methods for studying coincidences.
                    <em>Journal of the American Statistical Association, 84</em>(408), 853&ndash;861.
                    <a href="https://doi.org/10.1080/01621459.1989.10478847" target="_blank" rel="noopener noreferrer" class="text-purple-600 underline hover:text-purple-800">doi:10.1080/01621459.1989.10478847</a>
                </li>
            </ul>
        </div>
    </div>

    <p class="text-xs text-slate-500 mt-4">
        Further reading:
        <a href="https://en.wikipedia.org/wiki/Bayes_factor" target="_blank" rel="noopener noreferrer" class="text-purple-600 underline hover:text-purple-800">Bayes factors on Wikipedia</a>.
    </p>

    <!-- Series navigation: Part 4 of 4, the final part. No "Next" button by convention. -->
    <div class="mt-8 flex items-center justify-start gap-3">
        <a
            href={withBase('/random-streaks/', base)}
            class="inline-flex items-center gap-1.5 px-5 py-3 rounded-lg font-semibold shadow-sm transition-colors bg-slate-200 text-slate-700 hover:bg-slate-300"
        >
            <span aria-hidden="true">&larr;</span>
            Back to Random streaks
        </a>
    </div>
</ParadoxLayout>

<!-- is:global for the same reason as the other Clustering Illusion pages: cells, labels,
     and messages are filled in by the script after load. Every selector is prefixed pc-
     (Pattern or Coincidence) so nothing collides with ci-/hmr-/rs- from Parts 1-3.

     COLORS: event/no-event cells never rely on color alone -- filled vs. empty circle
     shape is the primary signal, matching Part 1's approach. The generator-label accent
     colors (teal for constant, amber for dependent) reuse the same pair from Part 3's
     streak highlighting, which was already checked for distinguishability across
     protanopia/deuteranopia/tritanopia (differ in both hue and luminance). -->
<style is:global>
    /* --- Sequence timeline --- */
    .pc-cell {
        aspect-ratio: 1 / 1;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9999px;
        border: 1.5px solid #94a3b8; /* slate-400 */
        background: #fff;
        transition: opacity 180ms ease, background-color 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
    }
    .pc-cell[data-event="true"] { background: #334155; border-color: #334155; } /* slate-700: filled = event */
    .pc-cell[data-event="false"] { background: #fff; } /* empty = no event */
    .pc-cell[data-scan-highlight="true"] {
        box-shadow: 0 0 0 2px #fff, 0 0 0 4px #7c3aed; /* purple-600 ring, distinct from event fill color */
    }

    /* --- Answer buttons --- */
    .pc-answer-btn {
        min-height: 44px;
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.875rem;
        background: #f1f5f9;
        color: #1e293b;
        border: 2px solid #cbd5e1;
        transition: background-color 0.15s, border-color 0.15s;
    }
    .pc-answer-btn:hover:not(:disabled) { background: #e2e8f0; border-color: #94a3b8; }
    .pc-answer-btn:focus-visible { outline: 2px solid #0d9488; outline-offset: 2px; }
    .pc-answer-btn[aria-pressed="true"] { background: #0f766e; border-color: #0f766e; color: #fff; }
    .pc-answer-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    /* --- Reveal fade-in --- */
    .pc-reveal { transition: opacity 220ms ease; }
    .pc-fade-in { animation: pc-fade-in-kf 260ms ease-out; }
    @keyframes pc-fade-in-kf {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    /* --- Sequence fade (round change) --- */
    .pc-fade { transition: opacity 180ms ease; }
    .pc-fade[data-faded="true"] { opacity: 0; }

    /* --- Feedback box (same convention as Parts 1-3) --- */
    .pc-box {
        margin-top: 1rem;
        padding: 0.75rem;
        border: 1px solid #e2e8f0;
        border-radius: 0.5rem;
        background: #f8fafc;
        color: #1e293b;
        font-size: 0.875rem;
        line-height: 1.4;
        min-height: 5.5rem;
    }
    @media (min-width: 640px) {
        .pc-box { font-size: 1rem; min-height: 4rem; }
    }
    @keyframes pc-flash-kf {
        from { background-color: #ede9fe; border-color: #7c3aed; }
        to   { background-color: #f8fafc; border-color: #e2e8f0; }
    }
    .pc-flash { animation: pc-flash-kf 700ms ease-out; }

    /* --- Modal ("Show me the math") --- */
    .pc-dialog {
        border: none;
        border-radius: 1rem;
        padding: 0;
        max-width: 32rem;
        width: calc(100vw - 2rem);
        max-height: calc(100vh - 4rem);
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.25);
    }
    .pc-dialog::backdrop { background: rgba(15, 23, 42, 0.5); }
    .pc-dialog-inner { padding: 1.25rem; overflow-y: auto; max-height: calc(100vh - 4rem); }
    .pc-dialog-close {
        min-width: 32px; min-height: 32px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 9999px;
        font-size: 1.25rem;
        line-height: 1;
        color: #475569;
        background: #f1f5f9;
        flex-shrink: 0;
    }
    .pc-dialog-close:hover { background: #e2e8f0; }
    .pc-dialog-close:focus-visible { outline: 2px solid #0d9488; outline-offset: 2px; }

    .sr-only {
        position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
    }

    @media (prefers-reduced-motion: reduce) {
        .pc-cell, .pc-reveal, .pc-fade, .pc-answer-btn { transition: none; }
        .pc-fade-in { animation: none; }
        .pc-flash { animation: none; }
    }
</style>

<script>
    import '../scripts/paradoxes/when-does-a-pattern-mean-something.js';
</script>
