---
import ParadoxLayout from '../layouts/ParadoxLayout.astro';
---

<ParadoxLayout slug="benfords-law">
    <p class="text-slate-600 mb-6">
        Benford's Law says that in many real-world datasets, numbers are much more likely to begin
        with smaller digits than larger ones. About 30% begin with 1, while fewer than 5% begin with
        9 &mdash; not the roughly even 11.1% each digit would get if first digits were random. Choose
        a dataset below and watch how its first digits compare with Benford's prediction.
    </p>

    <section class="bg-slate-50 p-5 rounded-xl border border-slate-100 mb-6 grid gap-5 md:grid-cols-[minmax(240px,1fr)_minmax(280px,1.2fr)] items-end">
        <div>
            <label for="bl-dataset" class="block text-sm font-semibold text-slate-700 mb-2">Example dataset</label>
            <select id="bl-dataset" class="w-full px-4 py-2 rounded-lg border border-slate-300 bg-white text-slate-800 font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-purple-500">
                <option value="growth">Proportional growth (idealized)</option>
                <option value="fibonacci">Fibonacci numbers</option>
                <option value="population">Population-like values</option>
                <option value="salary">Salary-like values</option>
                <option value="serial">Assigned serial numbers</option>
                <option value="gene">Gene expression (RNA-seq-like)</option>
            </select>
        </div>
        <div>
            <label class="flex justify-between text-sm font-semibold text-slate-700 mb-2">
                <span>Observations</span>
                <span id="bl-n-out" class="text-purple-600 font-mono">5,000</span>
            </label>
            <input id="bl-n" type="range" min="100" max="20000" step="100" value="5000" class="w-full accent-purple-600">
        </div>
    </section>

    <section class="grid gap-6 mb-6">
        <article class="bg-white rounded-xl border border-slate-200 overflow-hidden grid md:grid-cols-[minmax(0,1.2fr)_minmax(280px,0.8fr)]">
            <div class="p-5 md:border-r border-slate-200">
                <div class="text-xs font-bold uppercase tracking-wider text-slate-400">1 &middot; First digits</div>
                <div class="flex justify-between items-baseline gap-4 mt-1">
                    <strong class="text-base text-slate-800">Observed first-digit distribution</strong>
                    <span id="bl-chart-sub" class="text-xs text-slate-500">5,000 observations</span>
                </div>
                <p class="text-sm text-slate-500 mt-2">
                    Purple bars show the selected sample. Amber marks show Benford's predicted
                    first-digit percentages.
                </p>

                <div id="bl-chart" class="bl-chart mt-4"></div>

                <div class="flex flex-wrap gap-4 mt-3 text-xs text-slate-500">
                    <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-sm inline-block" style="background:#9333ea"></span>Observed</div>
                    <div class="flex items-center gap-2"><span class="w-3 h-2 rounded-sm inline-block" style="background:#b45309"></span>Benford reference</div>
                </div>
            </div>

            <aside class="p-5 bg-slate-50 md:rounded-r-xl">
                <h2 id="bl-context-title" class="text-lg font-bold text-slate-900 leading-snug"></h2>
                <p id="bl-context-copy" class="text-sm text-slate-600 mt-2 leading-relaxed"></p>

                <div class="mt-4 p-3 rounded-lg border border-slate-200 bg-white">
                    <div class="flex justify-between items-baseline gap-3">
                        <strong class="text-sm text-slate-700">How closely does this sample follow Benford?</strong>
                        <span id="bl-fit-badge" class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700">Close</span>
                    </div>
                    <div id="bl-fit-value" class="text-2xl font-extrabold text-slate-900 mt-1">0.00 pp</div>
                    <p class="text-xs text-slate-500 mt-1 leading-snug">
                        average absolute gap between the nine observed bars and Benford, in
                        percentage points
                    </p>
                </div>
            </aside>
        </article>

        <div class="grid gap-3 grid-cols-1 sm:grid-cols-3">
            <div class="bg-white rounded-xl border border-slate-200 p-4">
                <div id="bl-digit1-out" class="text-xl font-extrabold text-slate-900">30.1%</div>
                <div class="text-xs text-slate-500 mt-1">numbers beginning with 1</div>
                <div class="text-[11px] text-slate-500 mt-2 pt-2 border-t border-slate-100">
                    Benford predicts <strong class="text-slate-700">30.1%</strong>
                </div>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 p-4">
                <div id="bl-digit9-out" class="text-xl font-extrabold text-slate-900">4.6%</div>
                <div class="text-xs text-slate-500 mt-1">numbers beginning with 9</div>
                <div class="text-[11px] text-slate-500 mt-2 pt-2 border-t border-slate-100">
                    Benford predicts <strong class="text-slate-700">4.6%</strong>
                </div>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 p-4">
                <div id="bl-spread-out" class="text-xl font-extrabold text-slate-900">6.5&times;</div>
                <div class="text-xs text-slate-500 mt-1">how much more often 1 appears than 9</div>
                <div class="text-[11px] text-slate-500 mt-2 pt-2 border-t border-slate-100">
                    Benford predicts <strong id="bl-benford-ratio-out" class="text-slate-700">6.6&times;</strong>
                </div>
            </div>
        </div>

        <article class="bg-white rounded-xl border border-slate-200 p-5">
            <div class="text-xs font-bold uppercase tracking-wider text-slate-400">2 &middot; Additional details</div>
            <div class="text-base font-bold text-slate-800 mt-1">What is happening behind the bars?</div>

            <div class="grid gap-3 grid-cols-1 sm:grid-cols-2 mt-3">
                <div class="p-3 rounded-lg border border-slate-200 bg-slate-50">
                    <div id="bl-range-out" class="text-base font-bold text-slate-800">&mdash;</div>
                    <div class="text-[11px] text-slate-500 mt-1">approximate numeric range</div>
                </div>
                <div class="p-3 rounded-lg border border-slate-200 bg-slate-50">
                    <div id="bl-orders-out" class="text-base font-bold text-slate-800">&mdash;</div>
                    <div class="text-[11px] text-slate-500 mt-1">orders of magnitude spanned</div>
                </div>
            </div>

            <div id="bl-scale-block" class="mt-4">
                <div class="text-xs font-semibold text-slate-500">Benford's first-digit regions on a logarithmic scale</div>
                <div id="bl-scale" class="bl-scale mt-2">
                    <div id="bl-scale-track" class="bl-scale-track"></div>
                </div>
            </div>

            <p id="bl-context-note" class="text-xs text-amber-900 bg-amber-50 border border-amber-200 rounded-lg mt-3 p-3 leading-relaxed"></p>
        </article>

        <article class="bg-white rounded-xl border border-slate-200 p-5 text-sm text-slate-600">
            <strong class="text-slate-800">The lesson:</strong>
            Benford's Law is not a rule that every dataset must obey. It works best for certain kinds
            of naturally occurring, wide-ranging or multiplicative data. Assigned numbers and tightly
            constrained values can behave very differently.
        </article>
    </section>

    <p class="text-xs text-slate-500 mt-6" id="bl-footnote">
        Further reading:
        <a href="https://en.wikipedia.org/wiki/Benford%27s_law" target="_blank" rel="noopener noreferrer" class="text-purple-600 underline hover:text-purple-800">Benford's Law on Wikipedia</a>.
    </p>
</ParadoxLayout>

<style is:global>
    /* Hand-built bar chart and log-scale diagram: layout these need (equal-width
       columns, bars anchored to a shared baseline, a horizontal reference line
       floated at a percentage height) isn't easily expressed with utility
       classes alone, so it stays as plain CSS here.

       is:global is required, not optional: benfords-law.js builds the bar and
       scale-segment elements at runtime via innerHTML, so they never receive
       Astro's scoped data-astro-cid attribute. A scoped <style> block would
       compile its selectors to ".bl-bar[data-astro-cid-xxxxx]", which never
       matches those runtime-created elements, leaving the bars completely
       unstyled (zero height, no color). Colors are supplied inline by the
       script (benfords-law.js) using the site's purple/amber palette. */
    .bl-chart {
        display: grid;
        grid-template-columns: repeat(9, minmax(0, 1fr));
        gap: 8px;
        height: 220px;
        align-items: end;
        padding-top: 6px;
        border-bottom: 1px solid #e2e8f0; /* slate-200 */
    }
    .bl-bar-col {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: end;
        align-items: center;
        gap: 5px;
    }
    .bl-bar-area {
        width: 100%;
        flex: 1;
        display: flex;
        align-items: end;
        justify-content: center;
        position: relative;
    }
    .bl-bar {
        width: 70%;
        min-width: 14px;
        border-radius: 6px 6px 0 0;
        background: #9333ea; /* purple-600, matches site's Group 4 accent */
        transition: height 0.18s ease;
    }
    .bl-reference {
        position: absolute;
        left: 5%;
        right: 5%;
        height: 2px;
        background: #b45309; /* amber-700: distinguishable from purple across common colorblindness types */
    }
    .bl-bar-pct {
        font-size: 10px;
        color: #64748b; /* slate-500 */
        min-height: 15px;
    }
    .bl-bar-label {
        font-size: 12px;
        font-weight: 700;
        color: #334155; /* slate-700 */
    }

    .bl-scale {
        position: relative;
        height: 92px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #fff;
        overflow: hidden;
    }
    .bl-scale-track {
        position: absolute;
        left: 18px;
        right: 18px;
        top: 39px;
        height: 12px;
        background: #f1f5f9; /* slate-100 */
        border: 1px solid #e2e8f0;
        border-radius: 999px;
    }
    .bl-segment {
        position: absolute;
        top: 0;
        height: 100%;
        border-right: 1px solid rgba(255, 255, 255, 0.8);
    }
    .bl-segment:nth-child(odd) {
        background: #ede9fe; /* purple-100 */
    }
    .bl-segment:nth-child(even) {
        background: #ddd6fe; /* purple-200 */
    }
    .bl-segment-label,
    .bl-segment-pct {
        position: absolute;
        transform: translateX(-50%);
        font-size: 10px;
    }
    .bl-segment-label {
        top: 59px;
        color: #64748b; /* slate-500 */
    }
    .bl-segment-pct {
        top: 10px;
        font-weight: 700;
        color: #6b21a8; /* purple-800 */
    }

    @media (max-width: 500px) {
        .bl-chart {
            gap: 4px;
            height: 200px;
        }
        .bl-bar {
            width: 82%;
        }
    }
</style>

<script>
    import '../scripts/paradoxes/benfords-law.js';
</script>
