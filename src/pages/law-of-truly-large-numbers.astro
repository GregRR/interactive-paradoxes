---
import ParadoxLayout from '../layouts/ParadoxLayout.astro';
---

<ParadoxLayout slug="law-of-truly-large-numbers">
    <p class="text-slate-600 mb-6">The Law of Truly Large Numbers says that with enough opportunities, even extremely unlikely events are likely to happen.
    In a sufficiently large population or over enough trials, “miraculous” coincidences become statistically expected.
    Watch how highly improbable events become inevitable as the number of opportunities (trials) increases.</p>

    <div class="bg-slate-50 p-5 rounded-xl border border-slate-100 mb-6 grid gap-4 md:grid-cols-2">
        <div>
            <label class="flex justify-between text-sm font-semibold text-slate-700 mb-2">
                Odds (1 in X): <span id="odds-val" class="text-blue-600 font-mono">20,000,000</span>
            </label>
            <input type="range" id="odds-slider" min="1000" max="200000000" step="1000" value="20000000" class="w-full accent-blue-600">
        </div>
        <div>
            <label class="flex justify-between text-sm font-semibold text-slate-700 mb-2">
                Number of Trials: <span id="trials-val" class="text-blue-600 font-mono">100,000,000</span>
            </label>
            <input type="range" id="trials-slider" min="1000" max="350000000" step="1000" value="100000000" class="w-full accent-blue-600">
        </div>
    </div>
    <div id="plot1" class="w-full h-80"></div>
    <div id="ln-result" class="mt-4 text-center p-4 bg-blue-50 text-blue-900 rounded-lg text-lg"></div>
     <p class="text-xs text-slate-500 mt-6" id="brn-footnote">
        Further reading:
        <a href="https://en.wikipedia.org/wiki/Law_of_truly_large_numbers" target="_blank" rel="noopener noreferrer" class="text-purple-600 underline hover:text-purple-800">Law of Truly Large Numbers on Wikipedia</a>.
		  </p>
</ParadoxLayout>

<script>
    import '../scripts/paradoxes/law-of-truly-large-numbers.js';
</script>
