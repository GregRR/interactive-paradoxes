---
import ParadoxLayout from '../layouts/ParadoxLayout.astro';
---

<ParadoxLayout slug="littlewoods-law">
    <p class="text-slate-600 mb-6">Littlewood’s Law says that a person experiences roughly one “miracle” per month,
    if a miracle is defined as a one-in-a-million event. The idea is that we experience so many events each day that
    rare coincidences become surprisingly common. Calculate how many days it takes for a one-in-a-million event to happen based on your daily awareness rate.</p>

    <div class="bg-slate-50 p-5 rounded-xl border border-slate-100 mb-6 grid gap-6 md:grid-cols-3">
        <div>
            <label class="flex justify-between text-sm font-semibold text-slate-700 mb-2">
                Miracle (1 in X): <span id="lw-odds-val" class="text-blue-600 font-mono">1,000,000</span>
            </label>
            <input type="range" id="lw-odds-slider" min="100000" max="5000000" step="100000" value="1000000" class="w-full accent-blue-600">
        </div>
        <div>
            <label class="flex justify-between text-sm font-semibold text-slate-700 mb-2">
                Events/Sec: <span id="lw-events-val" class="text-blue-600 font-mono">1.0</span>
            </label>
            <input type="range" id="lw-events-slider" min="0.1" max="5" step="0.1" value="1" class="w-full accent-blue-600">
        </div>
        <div>
            <label class="flex justify-between text-sm font-semibold text-slate-700 mb-2">
                Active Hours/Day: <span id="lw-hours-val" class="text-blue-600 font-mono">8</span>
            </label>
            <input type="range" id="lw-hours-slider" min="1" max="24" step="1" value="8" class="w-full accent-blue-600">
        </div>
    </div>
    <div id="plot2" class="w-full h-64"></div>
    <div id="lw-result" class="mt-4 text-center p-4 bg-emerald-50 text-emerald-900 rounded-lg text-lg"></div>
    <p class="text-xs text-slate-500 mt-6" id="brn-footnote">
        Further reading:
        <a href="https://en.wikipedia.org/wiki/Littlewood%27s_law" target="_blank" rel="noopener noreferrer" class="text-purple-600 underline hover:text-purple-800">Littlewood's Law on Wikipedia</a>.
		</p>
</ParadoxLayout>

<script>
    import '../scripts/paradoxes/littlewoods-law.js';
</script>
