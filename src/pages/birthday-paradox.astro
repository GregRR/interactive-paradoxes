---
import ParadoxLayout from '../layouts/ParadoxLayout.astro';
---

<ParadoxLayout slug="birthday-paradox">
    <p class="text-slate-600 mb-6">The Birthday Paradox (or Birthday problem) is the counterintuitive fact that in a group of just 23 people, there’s already about a 50% chance that two share a birthday. It happens because you’re comparing many possible pairs, not just one person against everyone else.
    Explore the probabilities as the number of people in the room changes. Toggle the switch to see the difference between Paradox "Any Match" and matching "YOUR Birthday Match".</p>

    <div class="bg-slate-50 p-5 rounded-xl border border-slate-100 mb-6 flex flex-col md:flex-row md:items-center gap-6 justify-between">
        <div class="flex-1">
            <label class="flex justify-between text-sm font-semibold text-slate-700 mb-2">
                People in the Room: <span id="bp-val" class="text-emerald-600 font-mono text-lg">23</span>
            </label>
            <input type="range" id="bp-slider" min="1" max="300" step="1" value="23" class="w-full accent-emerald-600">
        </div>
        <div class="flex items-center space-x-3 bg-white p-3 rounded-lg border border-slate-200 shadow-sm">
            <span class="text-sm font-semibold text-slate-700">Compare "My Specific Birthday"</span>
            <div class="relative inline-block w-12 mr-2 align-middle select-none transition duration-200 ease-in">
                <input type="checkbox" name="toggle" id="bp-toggle" class="toggle-checkbox absolute block w-6 h-6 rounded-full bg-white border-4 border-slate-300 appearance-none cursor-pointer transition-colors duration-200 ease-in-out"/>
                <label for="bp-toggle" class="toggle-label block overflow-hidden h-6 rounded-full bg-slate-300 cursor-pointer transition-colors duration-200 ease-in-out"></label>
            </div>
        </div>
    </div>
    <div id="plot3" class="w-full h-96"></div>
    <div id="bp-result" class="mt-4 text-center p-4 bg-emerald-50 text-emerald-900 rounded-lg text-lg"></div>
    <p class="text-xs text-slate-500 mt-6" id="brn-footnote">
        Further reading:
        <a href="https://en.wikipedia.org/wiki/Birthday_problem" target="_blank" rel="noopener noreferrer" class="text-purple-600 underline hover:text-purple-800">Birthday Problem on Wikipedia</a>.
		</p>
</ParadoxLayout>

<script>
    import '../scripts/paradoxes/birthday-paradox.js';
</script>
