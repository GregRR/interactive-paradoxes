---
import ParadoxLayout from '../layouts/ParadoxLayout.astro';
---

<ParadoxLayout slug="friendship-paradox">
    <p class="text-slate-600 mb-6">The Friendship Paradox says that, on average, your friends have more friends than you do. This happens because highly connected people are more likely to appear in other people’s friend groups.
    Adjust your own immediate friend group size. Notice how the mathematical average of your friends' friend count almost always exceeds your own, driven by highly connected central nodes.</p>

    <div class="bg-slate-50 p-5 rounded-xl border border-slate-100 mb-6 max-w-md mx-auto">
        <label class="flex justify-between text-sm font-semibold text-slate-700 mb-2">
            Your Friend Count: <span id="fp-val" class="text-orange-500 font-mono text-lg">5</span>
        </label>
        <input type="range" id="fp-slider" min="1" max="50" step="1" value="10" class="w-full accent-orange-500">
    </div>

    <div class="grid md:grid-cols-2 gap-6">
        <div>
            <div id="plot4a" class="w-full h-80"></div>
            <div id="fp-result" class="mt-4 text-center p-4 bg-orange-50 text-orange-900 rounded-lg text-sm"></div>
        </div>
        <div>
            <div id="plot4b" class="w-full h-80 bg-slate-50 rounded-xl border border-slate-200"></div>
            <p class="text-center text-xs text-slate-500 mt-2">Node-Link Diagram (Larger nodes = More connections)</p>
        </div>
        <p class="text-xs text-slate-500 mt-6" id="brn-footnote">
        	Further reading:
       	 	<a href="https://en.wikipedia.org/wiki/Friendship_paradox" target="_blank" rel="noopener noreferrer" class="text-purple-600 underline hover:text-purple-800">Friendship Paradox on Wikipedia</a>.
			</p>
    </div>
</ParadoxLayout>

<script>
    import '../scripts/paradoxes/friendship-paradox.js';
</script>
