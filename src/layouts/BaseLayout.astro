---
/**
 * Page shell shared by every page: <head>, mobile header, sidebar, content
 * column, and footer.
 *
 * Props:
 *   title        <title> text.
 *   description  Optional meta description (what search results show).
 *   plotly       Load Plotly.js. Only pass true on pages whose exhibit uses it.
 *   currentSlug  Slug of the current paradox, for highlighting in the sidebar.
 */
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

const { title, description, plotly = false, currentSlug } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    {description && <meta name="description" content={description}>}
    {/* Plotly.js, loaded from the CDN only on pages that draw with it. `defer` keeps it from
         blocking first paint while still running before the page's own (module) scripts. */}
    {plotly && <script is:inline defer src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>}
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased overflow-hidden flex h-screen">

    <!-- Mobile Header & Hamburger -->
    <div class="md:hidden fixed top-0 left-0 w-full bg-slate-900 text-white z-50 flex items-center justify-between p-4 shadow-md">
        <a href={base} class="font-bold text-lg tracking-tight">Interactive Paradoxes</a>
        <button id="mobile-menu-btn" aria-label="Toggle menu" class="p-2 focus:outline-none focus:ring-2 focus:ring-slate-400 rounded">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
    </div>

    <Sidebar currentSlug={currentSlug} />

    <!-- Main Content Area -->
    <main class="flex-1 overflow-y-auto bg-slate-50 relative pt-16 md:pt-0">
        <div class="max-w-5xl mx-auto p-4 md:p-8">

            <slot />

            <!-- Footer -->
            <footer class="mt-12 text-center text-slate-500 text-sm pb-8">
                Created as an interactive sandbox for statistical paradoxes. Code released under the MIT License.
            </footer>

        </div>
    </main>

    <script>
        import '../scripts/mobile-menu.js';
    </script>
</body>
</html>
